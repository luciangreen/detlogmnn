{
  "name": "detlogmnn-desktop",
  "productName": "Detlog MNN",
  "version": "1.0.0",
  "description": "Detlog MNN for Mac, Windows and Linux: the site in a desktop window, with files in a folder on the computer.",
  "main": "main.js",
  "license": "BSD-3-Clause",
  "author": "Lucian Green",
  "scripts": {
    "start": "node copy-site.js && electron .",
    "dist": "node copy-site.js && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.luciangreen.detlogmnn",
    "productName": "Detlog MNN",
    "files": ["main.js", "preload.js", "fsbridge.js", "site/**/*"],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools", "icon": "site/icons/icon-512.png" },
    "win": { "target": ["nsis", "zip"], "icon": "site/icons/icon-512.png" },
    "linux": { "target": ["AppImage", "deb"], "category": "Development", "icon": "site/icons/icon-512.png", "maintainer": "Lucian Green" }
  }
}
